#!/usr/bin/env bash
# vi: ft=bash

set -e

echo "Updating Git submodules..."
git submodule update --init --recursive --quiet

echo "Checking Zola installation..."
if ! command -v zola &>/dev/null; then
  echo "Error: Zola is not installed. Please install Zola to proceed." >&2
  echo "See: https://www.getzola.org/documentation/getting-started/installation/" >&2
  exit 1
fi

echo "Building Zola site..."
# Redirect stdout to /dev/null to suppress Zola's regular build output,
# but allow stderr (errors) to pass through.
zola build >/dev/null

pushd public &>/dev/null

echo "Initializing Git repository in public/ (if not already present)..."
if [ ! -d ".git" ]; then
  git init --quiet
fi

echo "Verifying Git remote 'origin' configuration..."
REQUIRED_ORIGIN="git@github.com:mxaddict/www.codedmaster.com.git"
CURRENT_ORIGIN=$(git remote get-url origin 2>/dev/null || echo "")

if [ "$CURRENT_ORIGIN" != "$REQUIRED_ORIGIN" ]; then
  echo "Configuring Git remote 'origin'..."
  if git remote get-url origin &>/dev/null; then
    git remote set-url origin "$REQUIRED_ORIGIN" &>/dev/null
  else
    git remote add origin "$REQUIRED_ORIGIN" &>/dev/null
  fi
else
  echo "Git remote 'origin' is correctly configured."
fi

echo "Creating .nojekyll file to prevent Jekyll processing..."
touch .nojekyll

if [ -f "../CNAME" ]; then
  echo "Copying CNAME file..."
  cp ../CNAME . &>/dev/null
fi

echo "Staging changes for commit..."
git add -A

echo "Committing changes..."
if git diff --cached --exit-code --quiet; then
  echo "No new changes to commit."
else
  git commit -m "Deploy to GitHub Pages" --quiet
fi

echo "Pushing to gh-pages branch..."
git push -f origin HEAD:gh-pages --quiet

echo "Deployment complete."

popd &>/dev/null
